# Lab harness session config — copy to tools/lab/.env.lab and source it:
#   set -a; source tools/lab/.env.lab; set +a
# (.env.lab is gitignored; tokens expire per session)

GENESYS_ENV=usw2.pure.cloud
GENESYS_TOKEN_A1=            # bearer token for JE- AI Agent 01 (developer tools login)
GENESYS_TOKEN_A2=            # bearer token for JE- AI Agent 02 (needed for S3/S4)

CISCO_HOST=192.168.1.111
CISCO_USER=admin
CISCO_PASS=
CISCO_DIAL=31100@genesys.pexsupport.com

# Pexip mgmt creds auto-read from ~/.claude.json (pexip-mgmt MCP entry);
# override with PEXIP_HOST / PEXIP_OAUTH2_CLIENT_ID / PEXIP_OAUTH2_PRIVATE_KEY.

