# Copy to `.env` (or `.env.local`) and fill in before building.

# OAuth client (implicit grant) created in the Genesys Cloud org.
VITE_GENESYS_OAUTH_CLIENT_ID=

# Base path where the built app is hosted. Must match the hosting path.
VITE_BASE_PATH=/telecom/agent-app/

# Dev only: record the raw Genesys notification stream. Never set in production.
# VITE_CAPTURE_EVENTS=false
